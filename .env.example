# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model override (defaults to claude-opus-5)
# CLAUDE_MODEL=claude-opus-5

# Optional: response token cap (defaults to 8192)
# MAX_TOKENS=8192

# Optional: skip the y/n confirmation before running bash commands.
# Off by default on purpose - only turn this on in a throwaway/sandboxed dir.
# AUTO_APPROVE_BASH=true

# Optional: skip the y/n confirmation before create/str_replace/insert
# write to a file (view is read-only and never prompts either way). Kept
# separate from AUTO_APPROVE_BASH - trusting unattended shell access and
# trusting unattended file writes are different decisions.
# AUTO_APPROVE_EDITS=true

# Optional: stop the session once its estimated cost reaches this many
# dollars (defaults to 1.00). Checked after every API call, before any
# pending tool calls run. Set to 0 to disable entirely.
# SESSION_BUDGET_USD=1.00

# Optional: once the last API call's input_tokens crosses this, summarize
# older turns into one short note to keep the session going instead of
# eventually hitting the model's context window (defaults to 160000 -
# 80% of a standard 200K window). Only checked between turns.
# CONTEXT_COMPACT_THRESHOLD_TOKENS=160000

# Optional: how many of the most recent turns context compaction always
# leaves untouched, verbatim (defaults to 4).
# CONTEXT_KEEP_RECENT_TURNS=4
